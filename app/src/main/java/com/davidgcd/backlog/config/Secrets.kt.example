package com.davidgcd.backlog.config

/**
 * Copy this file to Secrets.kt (gitignored) and fill in your own credentials.
 * IGDB runs on Twitch's dev API: https://api-docs.igdb.com/#getting-started
 *
 * Metacritic has no free official API — the iOS app gets around this with a
 * paid proxy it built itself ("Flavo"). METACRITIC_RAPIDAPI_* below targets
 * a RapidAPI Metacritic provider instead: subscribe to one (search "metacritic"
 * on rapidapi.com), fill in its host + key, and adjust MetacriticApi's
 * endpoint/response shape to match that provider's contract if it differs —
 * see MetacriticService's doc comment. Until these are real, Metacritic
 * scores just never appear (same "no error, no card" rule as HowLongToBeat
 * on iOS), so leaving them as-is is safe.
 */
object Secrets {
    const val TWITCH_CLIENT_ID = "YOUR_TWITCH_CLIENT_ID"
    const val TWITCH_CLIENT_SECRET = "YOUR_TWITCH_CLIENT_SECRET"

    const val METACRITIC_RAPIDAPI_HOST = "YOUR_METACRITIC_RAPIDAPI_HOST"
    const val METACRITIC_RAPIDAPI_KEY = "YOUR_METACRITIC_RAPIDAPI_KEY"
}
